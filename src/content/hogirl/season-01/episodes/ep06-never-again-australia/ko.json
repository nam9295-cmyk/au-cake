      "alt": "HOGIRL의 감자튀김을 향해 날아드는 갈매기들.",
      "captions": [{ "placement": "after", "text": "그 순간—" }, { "placement": "after", "text": "촤아아악!!!" }, { "placement": "after", "text": "내 감자튀김!!!" }]
